  "components": {
    "schemas": {
      "ExportRequest": {
        "properties": {
          "format": {
            "type": "string",
            "const": "mp4",
            "title": "Format",
            "default": "mp4"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "ExportRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "PaymentProof": {
        "properties": {
          "transactionSignature": {
            "type": "string",
            "maxLength": 88,
            "minLength": 64,
            "title": "Transactionsignature"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "transactionSignature"
        ],
        "title": "PaymentProof"
      },
      "PurchaseRequest": {
        "properties": {
          "packId": {
            "type": "string",
            "const": "credits-100",
            "title": "Packid",
            "default": "credits-100"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "PurchaseRequest"
      },
      "RevisionRequest": {
        "properties": {
          "revisionOptionId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,100}$",
            "title": "Revisionoptionid"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "revisionOptionId"
        ],
        "title": "RevisionRequest"
      },
      "SelectionRequest": {
        "properties": {
          "scenarioId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,100}$",
            "title": "Scenarioid"
          },
          "selectionId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,100}$",
            "title": "Selectionid"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "scenarioId",
          "selectionId"
        ],
        "title": "SelectionRequest"
      },
      "ShotPatch": {
        "properties": {
          "flagged": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Flagged"
          },
          "locked": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Locked"
          },
          "selectedTakeId": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,100}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Selectedtakeid"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "ShotPatch"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "WalletProof": {
        "properties": {
          "challengeId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,100}$",
            "title": "Challengeid"
          },
          "signatureBase64": {
            "type": "string",
            "maxLength": 88,
            "minLength": 88,
            "title": "Signaturebase64"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "challengeId",
          "signatureBase64"
        ],
        "title": "WalletProof"
      },
      "WalletRequest": {
        "properties": {
          "walletAddress": {
            "type": "string",
            "maxLength": 44,
            "minLength": 32,
            "title": "Walletaddress"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "walletAddress"
        ],
        "title": "WalletRequest"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
